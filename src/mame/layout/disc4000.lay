license:CC0-1.0
-->
<mamelayout version="2">

<!-- define elements -->
	<element name="static_black">
		<rect>
			<color red="0.0" green="0.0" blue="0.0" />
		</rect>
	</element>

	<element name="green_led" defstate="0">
		<rect state="0">
			<color red="0" green="0.2" blue="0" />
		</rect>
		<rect state="1">
			<color red="0" green="0.8" blue="0" />
		</rect>
	</element>

	<element name="button_risk" defstate="0">
		<disk><bounds x="0.0" y="0.0" width="1.0" height="1.0" /><color red="0" green="0" blue="0.0" /></disk>
		<disk state="1"><bounds x="0.1" y="0.1" width="0.9" height="0.9" /><color red="1.0" green="1.0" blue="0.0" /></disk>
		<disk state="0"><bounds x="0.1" y="0.1" width="0.9" height="0.9" /><color red="0.7" green="0.7" blue="0.0" /></disk>
		<text string="1:1"><bounds x="0.3" y="0.2" width="0.5" height="0.4" /><color red="0" green="0" blue="0" /></text>
		<text string="RISIKO"><bounds x="0.2" y="0.6" width="0.7" height="0.2" /><color red="0" green="0" blue="0" /></text>
	</element>

	<element name="button_start" defstate="0">
		<disk><bounds x="0.0" y="0.0" width="1.0" height="1.0" /><color red="0" green="0" blue="0.0" /></disk>
		<disk state="1"><bounds x="0.1" y="0.1" width="0.9" height="0.9" /><color red="1.0" green="0.0" blue="0.0" /></disk>
		<disk state="0"><bounds x="0.1" y="0.1" width="0.9" height="0.9" /><color red="0.7" green="0.0" blue="0.0" /></disk>
		<text string="START"><bounds x="0.2" y="0.4" width="0.7" height="0.3" /><color red="0" green="0" blue="0" /></text>
	</element>

	<element name="button_stop" defstate="0">
		<disk><bounds x="0.0" y="0.0" width="1.0" height="1.0" /><color red="0" green="0" blue="0.0" /></disk>
		<disk state="1"><bounds x="0.1" y="0.1" width="0.9" height="0.9" /><color red="1.0" green="0.0" blue="0.0" /></disk>
		<disk state="0"><bounds x="0.1" y="0.1" width="0.9" height="0.9" /><color red="0.7" green="0.0" blue="0.0" /></disk>
		<text string="STOP"><bounds x="0.2" y="0.4" width="0.7" height="0.3" /><color red="0" green="0" blue="0" /></text>
	</element>

	<element name="digit" defstate="0">
		<led7seg>
			<color red="1.0" green="0.3" blue="0.2" />
		</led7seg>
	</element>

	<element name="disk_1symbol"><disk symbollist="sonne,60,40,80"><color red="0.8" green="0.8" blue="0.8" /></disk></element>
	<element name="disk_2symbol"><disk symbollist="40,sonne,40,80,40,sonne"><color red="0.8" green="0.8" blue="0.8" /></disk></element>

	<element name="ladder" defstate="0">
		<rect state="1">
			<color red="1.0" green="1.0" blue="1.0" />
		</rect>
		<rect state="0">
			<color red="0.7" green="0.7" blue="0.7" />
		</rect>
	</element>

	<element name="indicator_red" defstate="0">
		<rect state="1">
			<color red="1.0" green="0.0" blue="0.0" />
		</rect>
		<rect state="0">
			<color red="0.5" green="0.0" blue="0.0" />
		</rect>
	</element>

	<view name="Internal Layout">
		<bounds left="0" right="470" top="0" bottom="540" />
		<element ref="static_black">
			<bounds left="0" right="470" top="0" bottom="540" />
		</element>

<!-- left panel -->
		<!-- Sonderspiele / Serien counter (Anzout3, fields 0/1/3) -->
		<element name="digit30" ref="digit"><bounds x="2" y="2" width="11" height="15" /></element>
		<element name="digit33" ref="digit"><bounds x="15" y="2" width="11" height="15" /></element>
		<element name="digit31" ref="digit"><bounds x="28" y="2" width="11" height="15" /></element>
		<!-- Münzspeicher: 3 big (Anzout5, fields 2/0/3) -->
		<element name="digit52" ref="digit"><bounds x="48" y="2" width="13" height="17" /></element>
		<element name="digit50" ref="digit"><bounds x="62" y="2" width="13" height="17" /></element>
		<element name="digit53" ref="digit"><bounds x="76" y="2" width="13" height="17" /></element>
		<!-- Münzspeicher: 2 small (Anzout5 field 1, Anzout3 field 2) -->
		<element name="digit51" ref="digit"><bounds x="94" y="2" width="9" height="12" /></element>
		<element name="digit32" ref="digit"><bounds x="104" y="2" width="9" height="12" /></element>
		</element>

		<!-- 0.10DM,1DM,2DM,5DM -->
		<element name="anzled0" ref="green_led">
			<bounds x="385" y="45" width="5" height="5" />
		</element>

		<element name="anzled1" ref="green_led">
			<bounds x="385" y="55" width="5" height="5" />
		</element>

		<element name="anzled2" ref="green_led">
			<bounds x="385" y="65" width="5" height="5" />
		</element>

		<element name="anzled3" ref="green_led">
			<bounds x="385" y="75" width="5" height="5" />
		</element>


		<!-- coin return button 
		<element name="lamp36" ref="indicator_red">
			<bounds x="400" y="45" width="5" height="15" />
		</element>

		<element name="lamp37" ref="indicator_red">
			<bounds x="400" y="65" width="5" height="15" />
		</element>-->

<!-- lampZEILESPALTE -->

<!-- left panel -->
		<!-- Leiter II LZ3+LZ4+LZ6-->

		<element name="lamp40" ref="ladder">
			<bounds x="45" y="150" width="45" height="25" />
		</element>

		<element name="lamp34" ref="ladder">
			<bounds x="45" y="190" width="45" height="25" />
		</element>

		<element name="lamp33" ref="ladder">
			<bounds x="45" y="220" width="45" height="25" />
		</element>

		<element name="lamp32" ref="ladder">
			<bounds x="45" y="250" width="45" height="25" />
		</element>

		<element name="lamp31" ref="ladder">
			<bounds x="45" y="280" width="45" height="25" />
		</element>

		<element name="lamp" ref="ladder">
			<bounds x="45" y="310" width="45" height="25" />
		</element>

		<element name="lamp" ref="ladder">
			<bounds x="45" y="340" width="45" height="25" />
		</element>

		<element name="lamp" ref="ladder">
			<bounds x="45" y="370" width="45" height="25" />
		</element>

		<element name="lamp" ref="ladder">
			<bounds x="45" y="400" width="45" height="25" />
		</element>

		<element name="lamp" ref="ladder">
			<bounds x="45" y="430" width="45" height="25" />
		</element>

<!-- right panel -->
		<!-- Leiter I  LZ0+LZ4-->

		<element name="lamp" ref="ladder">
			<bounds x="390" y="150" width="45" height="25" />
		</element>

		<element name="lamp" ref="ladder">
			<bounds x="390" y="190" width="45" height="25" />
		</element>

		<element name="lamp" ref="ladder">
			<bounds x="390" y="220" width="45" height="25" />
		</element>

		<element name="lamp" ref="ladder">
			<bounds x="390" y="250" width="45" height="25" />
		</element>

		<element name="lamp" ref="ladder">
			<bounds x="390" y="280" width="45" height="25" />
		</element>

		<element name="lamp" ref="ladder">
			<bounds x="390" y="310" width="45" height="25" />
		</element>

		<element name="lamp64" ref="ladder">
			<bounds x="390" y="340" width="45" height="25" />
		</element>

		<element name="lamp" ref="ladder">
			<bounds x="390" y="370" width="45" height="25" />
		</element>

		<element name="lamp" ref="ladder">
			<bounds x="390" y="400" width="45" height="25" />
		</element>

		<element name="lamp" ref="ladder">
			<bounds x="390" y="430" width="45" height="25" />
		</element>

<!-- center LZ0+LZ2+LZ5-->
		<!-- gestoert -->
		<element name="lamp" ref="indicator_red">
			<bounds x="110" y="305" width="45" height="25" />
		</element>


		<element name="lamp" ref="ladder">
			<bounds x="130" y="335" width="45" height="25" />
		</element>

		<element name="lamp" ref="ladder">
			<bounds x="130" y="365" width="45" height="25" />
		</element>


		<element name="lamp" ref="ladder">
			<bounds x="175" y="320" width="45" height="25" />
		</element>

		<element name="lamp" ref="ladder">
			<bounds x="175" y="350" width="45" height="25" />
		</element>

		<element name="lamp" ref="ladder">
			<bounds x="175" y="380" width="45" height="25" />
		</element>


		<element name="lamp" ref="ladder">
			<bounds x="220" y="335" width="45" height="25" />
		</element>

		<element name="lamp" ref="ladder">
			<bounds x="220" y="365" width="45" height="25" />
		</element>


		<element name="lamp" ref="ladder">
			<bounds x="265" y="320" width="45" height="25" />
		</element>

		<element name="lamp" ref="ladder">
			<bounds x="265" y="350" width="45" height="25" />
		</element>

		<element name="lamp" ref="ladder">
			<bounds x="265" y="380" width="45" height="25" />
		</element>


		<element name="lamp" ref="ladder">
			<bounds x="310" y="335" width="45" height="25" />
		</element>

		<element name="lamp" ref="ladder">
			<bounds x="310" y="365" width="45" height="25" />
		</element>

<!-- bottom panel LZ0 -->
		<!-- Tasten -->
		<element name="lamp" ref="button_risk" inputtag="INPUTS" inputmask="0x02">
			<bounds x="50" y="480" width="35" height="35" />
		</element>

		<element name="lamp" ref="button_start" inputtag="INPUTS" inputmask="0x80">
			<bounds x="145" y="480" width="35" height="35" />
		</element>

		<element name="lamp" ref="button_stop" inputtag="INPUTS" inputmask="0x10">
			<bounds x="225" y="480" width="35" height="35" />
		</element>

		<element name="lamp" ref="button_stop" inputtag="INPUTS" inputmask="0x08">
			<bounds x="300" y="480" width="35" height="35" />
		</element>

		<element name="lamp" ref="button_risk" inputtag="INPUTS" inputmask="0x01">
			<bounds x="395" y="480" width="35" height="35" />
		</element>


		<element name="lamp" ref="ladder">
			<bounds x="50" y="520" width="45" height="10" />
		</element>

		<element name="lamp" ref="ladder">
			<bounds x="390" y="520" width="45" height="10" />
		</element>


		<element name="disc" ref="disk_1symbol">
			<bounds x="185" y="185" width="120" height="120" />
		</element>

		<element name="disc" ref="disk_1symbol">
			<bounds x="100" y="150" width="120" height="120" />
		</element>

		<element name="disc" ref="disk_1symbol">
			<bounds x="260" y="150" width="120" height="120" />
		</element>


	</view>
</mamelayout>
