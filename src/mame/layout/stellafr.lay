<?xml version="1.0"?>
<!--
license:CC0-1.0
-->
<mamelayout version="2">

	<element name="led_red" defstate="0">
		<disk state="1"><color red="1.0" green="0.1" blue="0.15" /></disk>
		<disk state="0"><color red="0.17" green="0.015" blue="0.02" /></disk>
	</element>

	<element name="green_led" defstate="0">
		<rect state="0">
			<color red="0" green="0.2" blue="0" />
		</rect>
		<rect state="1">
			<color red="0" green="0.8" blue="0" />
		</rect>
	</element>

<!-- define elements -->
	<element name="static_black">
		<rect>
			<color red="0.0" green="0.0" blue="0.0" />
		</rect>
	</element>

	<element name="digit" defstate="0">
		<led7seg>
			<color red="1.0" green="0.3" blue="0.2" />
		</led7seg>
	</element>

	<view name="Internal Layout">
		<bounds left="0" right="116" top="0" bottom="60" />
		<element ref="static_black">
			<bounds left="0" right="116" top="0" bottom="60" />
		</element>

<!-- four display modules of eight 7-seg digits each.
     The ROM renders into four module buffers; digit(f*8+d) is module f digit d.
     Digits are scanned MSB-first, so digit 0 is the rightmost on each module. -->
		<repeat count="4">
			<param name="f" start="0" increment="1" />
			<param name="row_y" start="2" increment="11" />
			<param name="d0" start="0" increment="8" />
			<repeat count="8">
				<!-- place digit 0 at the right, digit 7 at the left -->
				<param name="d" start="7" increment="-1" />
				<param name="x" start="2" increment="13" />
				<element name="digit~d0~~d~" ref="digit">
					<bounds x="~x~" y="~row_y~" width="11" height="9" />
				</element>
			</repeat>
		</repeat>

		<!-- control unit error LEDs -->
		<element name="led0" ref="led_red">
			<bounds x="2" y="50" width="4" height="4" />
		</element>
		<element name="led1" ref="led_red">
			<bounds x="8" y="50" width="4" height="4" />
		</element>

		<!-- lamp matrix debug grid -->
		<repeat count="12">
			<param name="s" start="0" increment="1" />
			<param name="x" start="20" increment="2" />
			<repeat count="8">
			<param name="z" start="0" increment="1" />
			<param name="y" start="50" increment="1" />
				<element name="lamp~z~~s~" ref="green_led">
					<bounds x="~x~" y="~y~" width="1" height="1" />
				</element>
			</repeat>
		</repeat>


	</view>
</mamelayout>
