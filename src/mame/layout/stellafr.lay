<?xml version="1.0"?>
<!--
license:CC0-1.0
-->
<mamelayout version="2">

	<element name="led_red" defstate="0">
		<disk state="1"><color red="1.0" green="0.1" blue="0.15" /></disk>
		<disk state="0"><color red="0.17" green="0.015" blue="0.02" /></disk>
	</element>

	<element name="green_led" defstate="0">
		<rect state="0">
			<color red="0" green="0.2" blue="0" />
		</rect>
		<rect state="1">
			<color red="0" green="0.8" blue="0" />
		</rect>
	</element>

<!-- define elements -->
	<element name="static_black">
		<rect>
			<color red="0.0" green="0.0" blue="0.0" />
		</rect>
	</element>

	<element name="digit" defstate="0">
		<led7seg>
			<color red="1.0" green="0.3" blue="0.2" />
		</led7seg>
	</element>

	<view name="Internal Layout">
		<bounds left="0" right="116" top="0" bottom="60" />
		<element ref="static_black">
			<bounds left="0" right="116" top="0" bottom="60" />
		</element>

<!-- four display modules of eight 7-seg digits each.
     The ROM renders into four module buffers; digit(f*8+d) is module f digit d.
     Digits are scanned so digit 0 is the rightmost on each module. -->
		<!-- display module 0: digit0..digit7 (digit0 = rightmost) -->
		<element name="digit0" ref="digit"><bounds x="100" y="2" width="12" height="10" /></element>
		<element name="digit1" ref="digit"><bounds x="86" y="2" width="12" height="10" /></element>
		<element name="digit2" ref="digit"><bounds x="72" y="2" width="12" height="10" /></element>
		<element name="digit3" ref="digit"><bounds x="58" y="2" width="12" height="10" /></element>
		<element name="digit4" ref="digit"><bounds x="44" y="2" width="12" height="10" /></element>
		<element name="digit5" ref="digit"><bounds x="30" y="2" width="12" height="10" /></element>
		<element name="digit6" ref="digit"><bounds x="16" y="2" width="12" height="10" /></element>
		<element name="digit7" ref="digit"><bounds x="2" y="2" width="12" height="10" /></element>
		<!-- display module 1: digit8..digit15 (digit0 = rightmost) -->
		<element name="digit8" ref="digit"><bounds x="100" y="14" width="12" height="10" /></element>
		<element name="digit9" ref="digit"><bounds x="86" y="14" width="12" height="10" /></element>
		<element name="digit10" ref="digit"><bounds x="72" y="14" width="12" height="10" /></element>
		<element name="digit11" ref="digit"><bounds x="58" y="14" width="12" height="10" /></element>
		<element name="digit12" ref="digit"><bounds x="44" y="14" width="12" height="10" /></element>
		<element name="digit13" ref="digit"><bounds x="30" y="14" width="12" height="10" /></element>
		<element name="digit14" ref="digit"><bounds x="16" y="14" width="12" height="10" /></element>
		<element name="digit15" ref="digit"><bounds x="2" y="14" width="12" height="10" /></element>
		<!-- display module 2: digit16..digit23 (digit0 = rightmost) -->
		<element name="digit16" ref="digit"><bounds x="100" y="26" width="12" height="10" /></element>
		<element name="digit17" ref="digit"><bounds x="86" y="26" width="12" height="10" /></element>
		<element name="digit18" ref="digit"><bounds x="72" y="26" width="12" height="10" /></element>
		<element name="digit19" ref="digit"><bounds x="58" y="26" width="12" height="10" /></element>
		<element name="digit20" ref="digit"><bounds x="44" y="26" width="12" height="10" /></element>
		<element name="digit21" ref="digit"><bounds x="30" y="26" width="12" height="10" /></element>
		<element name="digit22" ref="digit"><bounds x="16" y="26" width="12" height="10" /></element>
		<element name="digit23" ref="digit"><bounds x="2" y="26" width="12" height="10" /></element>
		<!-- display module 3: digit24..digit31 (digit0 = rightmost) -->
		<element name="digit24" ref="digit"><bounds x="100" y="38" width="12" height="10" /></element>
		<element name="digit25" ref="digit"><bounds x="86" y="38" width="12" height="10" /></element>
		<element name="digit26" ref="digit"><bounds x="72" y="38" width="12" height="10" /></element>
		<element name="digit27" ref="digit"><bounds x="58" y="38" width="12" height="10" /></element>
		<element name="digit28" ref="digit"><bounds x="44" y="38" width="12" height="10" /></element>
		<element name="digit29" ref="digit"><bounds x="30" y="38" width="12" height="10" /></element>
		<element name="digit30" ref="digit"><bounds x="16" y="38" width="12" height="10" /></element>
		<element name="digit31" ref="digit"><bounds x="2" y="38" width="12" height="10" /></element>

		<!-- control unit error LEDs -->
		<element name="led0" ref="led_red">
			<bounds x="2" y="50" width="4" height="4" />
		</element>
		<element name="led1" ref="led_red">
			<bounds x="8" y="50" width="4" height="4" />
		</element>

		<!-- lamp matrix debug grid -->
		<repeat count="12">
			<param name="s" start="0" increment="1" />
			<param name="x" start="20" increment="2" />
			<repeat count="8">
			<param name="z" start="0" increment="1" />
			<param name="y" start="50" increment="1" />
				<element name="lamp~z~~s~" ref="green_led">
					<bounds x="~x~" y="~y~" width="1" height="1" />
				</element>
			</repeat>
		</repeat>


	</view>
</mamelayout>
