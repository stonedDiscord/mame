<?xml version="1.0"?>
<!--
license:CC0-1.0
-->
<mamelayout version="2">

<!-- define elements -->
	<element name="static_black">
		<rect>
			<color red="0.0" green="0.0" blue="0.0" />
		</rect>
	</element>

	<element name="green_led" defstate="0">
		<rect state="0">
			<color red="0" green="0.2" blue="0" />
		</rect>
		<rect state="1">
			<color red="0" green="0.8" blue="0" />
		</rect>
	</element>

	<element name="button_bonus" defstate="0">
		<disk><bounds x="0.0" y="0.0" width="1.0" height="1.0" /><color red="0" green="0" blue="0.0" /></disk>
		<disk state="1"><bounds x="0.1" y="0.1" width="0.9" height="0.9" /><color red="1.0" green="1.0" blue="0.0" /></disk>
		<disk state="0"><bounds x="0.1" y="0.1" width="0.9" height="0.9" /><color red="0.7" green="0.7" blue="0.0" /></disk>
		<text string="Bonus"><bounds x="0.2" y="0.4" width="0.7" height="0.3" /><color red="0" green="0" blue="0" /></text>
	</element>

	<element name="button_risk" defstate="0">
		<rect><bounds x="0.0" y="0.0" width="1.0" height="1.0" /><color red="0" green="0" blue="0.0" /></rect>
		<rect state="1"><bounds x="0.1" y="0.1" width="0.9" height="0.9" /><color red="1.0" green="1.0" blue="0.0" /></rect>
		<rect state="0"><bounds x="0.1" y="0.1" width="0.9" height="0.9" /><color red="0.7" green="0.7" blue="0.0" /></rect>
		<text string="RISIKO"><bounds x="0.2" y="0.2" width="0.7" height="0.6" /><color red="0" green="0" blue="0" /></text>
	</element>

	<element name="button_start" defstate="0">
		<rect><bounds x="0.0" y="0.0" width="1.0" height="1.0" /><color red="0" green="0" blue="0.0" /></rect>
		<rect state="1"><bounds x="0.1" y="0.1" width="0.9" height="0.9" /><color red="1.0" green="1.0" blue="0.0" /></rect>
		<rect state="0"><bounds x="0.1" y="0.1" width="0.9" height="0.9" /><color red="0.7" green="0.7" blue="0.0" /></rect>
		<text string="Start-Stop"><bounds x="0.2" y="0.2" width="0.7" height="0.6" /><color red="0" green="0" blue="0" /></text>
	</element>

	<element name="digit" defstate="0">
		<led7seg>
			<color red="1.0" green="0.3" blue="0.2" />
		</led7seg>
	</element>

	<element name="ladder" defstate="0">
		<disk state="1">
			<color red="1.0" green="1.0" blue="1.0" />
		</disk>
		<disk state="0">
			<color red="0.5" green="0.5" blue="0.5" />
		</disk>
	</element>

	<element name="indicator_red" defstate="0">
		<rect state="1">
			<color red="1.0" green="0.0" blue="0.0" />
		</rect>
		<rect state="0">
			<color red="0.5" green="0.0" blue="0.0" />
		</rect>
	</element>

	<element name="dm_counter" defstate="0">
		<simplecounter maxstate="999" digits="3">
			<color red="1.0" green="1.0" blue="1.0"/>
		</simplecounter>
	</element>

	<!-- Geldspeicher counts 0.10 DM (ten Pfennig) units. -->
	<element name="ten_pf_counter" defstate="0">
		<simplecounter maxstate="90" digits="2">
			<color red="1.0" green="1.0" blue="1.0"/>
		</simplecounter>
	</element>

	<element name="sp_counter" defstate="0">
		<simplecounter maxstate="99" digits="2">
			<color red="1.0" green="1.0" blue="1.0"/>
		</simplecounter>
	</element>

	<view name="Internal Layout">
		<bounds left="0" right="470" top="0" bottom="540" />
		<element ref="static_black">
			<bounds left="0" right="470" top="0" bottom="540" />
		</element>

<!-- debug display -->
		<element name="digit15" ref="digit">
			<bounds x="0" y="0" width="10" height="15" />
		</element>
		<element name="digit14" ref="digit">
			<bounds x="10" y="0" width="10" height="15" />
		</element>
		<element name="digit13" ref="digit">
			<bounds x="20" y="0" width="10" height="15" />
		</element>
		<element name="digit12" ref="digit">
			<bounds x="30" y="0" width="10" height="15" />
		</element>
		<element name="digit11" ref="digit">
			<bounds x="40" y="0" width="10" height="15" />
		</element>
		<element name="digit10" ref="digit">
			<bounds x="50" y="0" width="10" height="15" />
		</element>
		<element name="digit9" ref="digit">
			<bounds x="60" y="0" width="10" height="15" />
		</element>
		<element name="digit8" ref="digit">
			<bounds x="70" y="0" width="10" height="15" />
		</element>

<!-- middle counter -->
		<!-- Sonderspiele (S: US/DS) -->
		<element name="counter2" ref="sp_counter">
			<bounds x="210" y="60" width="60" height="30" />
		</element>

<!-- left panel -->
		<!-- Münzspeicher (M: UM/DM) -->
		<element name="counter1" ref="dm_counter">
			<bounds x="10" y="20" width="55" height="30" />
		</element>
		<!-- Geldspeicher, in 10 Pfennig units (G: UG/DG) -->
		<element name="counter0" ref="ten_pf_counter">
			<bounds x="80" y="20" width="30" height="30" />
		</element>


		<!-- 5DM -->
		<element name="lamp50" ref="green_led">
			<bounds x="355" y="30" width="5" height="5" />
		</element>

		<!-- 2DM -->
		<element name="lamp51" ref="green_led">
			<bounds x="340" y="30" width="5" height="5" />
		</element>

		<!-- 1DM -->
		<element name="lamp52" ref="green_led">
			<bounds x="325" y="30" width="5" height="5" />
		</element>

		<!-- 0.10DM -->
		<element name="lamp53" ref="green_led">
			<bounds x="310" y="30" width="5" height="5" />
		</element>

		<!-- coin return button -->
		<element name="lamp36" ref="indicator_red">
			<bounds x="415" y="20" width="5" height="15" />
		</element>

		<element name="lamp54" ref="indicator_red">
			<bounds x="450" y="20" width="5" height="15" />
		</element>

<!-- lampZEILESPALTE -->

		<!-- Serie laeuft -->
		<element name="lamp34" ref="ladder">
			<bounds x="120" y="20" width="45" height="25" />
		</element>

		<!-- Stern -->
		<element name="lamp24" ref="ladder">
			<bounds x="215" y="15" width="40" height="40" />
		</element>

<!-- left panel -->
		<!-- 4054/030301-->

		<!-- 100 Sonderspiele -->
		<element name="lamp74" ref="ladder">
			<bounds x="150" y="55" width="40" height="40" />
		</element>

		<!-- 50 Sonderspiele -->
		<element name="lamp73" ref="ladder">
			<bounds x="110" y="75" width="40" height="40" />
		</element>

		<!-- 25 Sonderspiele -->
		<element name="lamp72" ref="ladder">
			<bounds x="75" y="100" width="40" height="40" />
		</element>

		<!-- 12 Sonderspiele -->
		<element name="lamp71" ref="ladder">
			<bounds x="50" y="135" width="40" height="40" />
		</element>

		<!-- 6 Sonderspiele -->
		<element name="lamp70" ref="ladder">
			<bounds x="40" y="175" width="40" height="40" />
		</element>

		<!-- 3 Sonderspiele -->
		<element name="lamp64" ref="ladder">
			<bounds x="40" y="210" width="40" height="40" />
		</element>

		<!-- 2,50 DM -->
		<element name="lamp63" ref="ladder">
			<bounds x="40" y="245" width="40" height="40" />
		</element>

		<!-- 1,20 DM -->
		<element name="lamp62" ref="ladder">
			<bounds x="40" y="280" width="40" height="40" />
		</element>

<!-- right panel -->
		<!-- 4054/030401 -->

		<!-- 65 Sonderspiele -->
		<element name="lamp34" ref="ladder">
			<bounds x="275" y="55" width="40" height="40" />
		</element>

		<!-- 32 Sonderspiele -->
		<element name="lamp33" ref="ladder">
			<bounds x="320" y="75" width="40" height="40" />
		</element>

		<!-- 16 Sonderspiele -->
		<element name="lamp47" ref="ladder">
			<bounds x="355" y="100" width="40" height="40" />
		</element>

		<!-- 8 Sonderspiele -->
		<element name="lamp46" ref="ladder">
			<bounds x="380" y="135" width="40" height="40" />
		</element>

		<!-- 4 Sonderspiele -->
		<element name="lamp45" ref="ladder">
			<bounds x="390" y="175" width="40" height="40" />
		</element>

		<!-- 2 Sonderspiele -->
		<element name="lamp44" ref="ladder">
			<bounds x="390" y="210" width="40" height="40" />
		</element>

		<!-- 1,70 DM -->
		<element name="lamp43" ref="ladder">
			<bounds x="390" y="245" width="40" height="40" />
		</element>

		<!-- 80pf -->
		<element name="lamp42" ref="ladder">
			<bounds x="390" y="280" width="40" height="40" />
		</element>

<!-- lower panel -->
		<!-- 4054/030101 -->

		<!-- Gestoert -->
		<element name="lamp26" ref="ladder">
			<bounds x="1" y="1" width="1" height="1" />
		</element>

		<!-- Stop W3 -->
		<element name="lamp02" ref="ladder">
			<bounds x="280" y="290" width="50" height="20" />
		</element>

		<!-- Stop W2 -->
		<element name="lamp04" ref="ladder">
			<bounds x="210" y="290" width="50" height="20" />
		</element>

		<!-- Start W1 -->
		<element name="lamp06" ref="ladder">
			<bounds x="140" y="290" width="50" height="20" />
		</element>

		<!-- 0,50/0,60 -->
		<element name="lamp61" ref="ladder">
			<bounds x="50" y="320" width="30" height="30" />
		</element>

		<!-- Nichts/Bonus II -->
		<element name="lamp31" ref="ladder">
			<bounds x="60" y="350" width="30" height="30" />
		</element>

		<!-- BL II 1 -->
		<element name="lamp10" ref="ladder">
			<bounds x="85" y="385" width="20" height="20" />
		</element>

		<!-- BL II 2 -->
		<element name="lamp11" ref="ladder">
			<bounds x="105" y="400" width="20" height="20" />
		</element>

		<!-- BL II 3 -->
		<element name="lamp12" ref="ladder">
			<bounds x="130" y="415" width="20" height="20" />
		</element>

		<!-- BL II 4 -->
		<element name="lamp13" ref="ladder">
			<bounds x="155" y="425" width="20" height="20" />
		</element>

		<!-- BL II 5 -->
		<element name="lamp14" ref="ladder">
			<bounds x="185" y="430" width="20" height="20" />
		</element>

		<!-- Voller Bonus -->
		<element name="lamp15" ref="ladder">
			<bounds x="215" y="405" width="40" height="40" />
		</element>

		<!-- BL I 5 -->
		<element name="lamp22" ref="ladder">
			<bounds x="275" y="430" width="20" height="20" />
		</element>

		<!-- BL I 4 -->
		<element name="lamp21" ref="ladder">
			<bounds x="300" y="425" width="20" height="20" />
		</element>

		<!-- BL I 3 -->
		<element name="lamp20" ref="ladder">
			<bounds x="325" y="415" width="20" height="20" />
		</element>

		<!-- BL I 2 -->
		<element name="lamp17" ref="ladder">
			<bounds x="350" y="400" width="20" height="20" />
		</element>

		<!-- BL I 1 -->
		<element name="lamp16" ref="ladder">
			<bounds x="370" y="385" width="20" height="20" />
		</element>

		<!-- Nichts/Bonus I -->
		<element name="lamp32" ref="ladder">
			<bounds x="385" y="350" width="30" height="30" />
		</element>

		<!-- 0,30/0,40 -->
		<element name="lamp41" ref="ladder">
			<bounds x="395" y="320" width="30" height="30" />
		</element>

		<!-- Serienplan -->
		<element name="lamp25" ref="ladder">
			<bounds x="130" y="320" width="100" height="40" />
		</element>

		<!-- Serienplan -->
		<element name="lamp27" ref="ladder">
			<bounds x="230" y="320" width="100" height="40" />
		</element>

		<!-- Startautomatik Ein -->
		<element name="lamp01" ref="ladder">
			<bounds x="410" y="450" width="30" height="25" />
		</element>

		<!-- Roulette stoppen -->
		<element name="lamp35" ref="ladder">
			<bounds x="5" y="5" width="1" height="1" />
		</element>

		<!-- Gewinn annehmen -->
		<element name="lamp03" ref="ladder">
			<bounds x="6" y="6" width="1" height="1" />
		</element>

		<!-- Spiel starten -->
		<element name="lamp05" ref="ladder">
			<bounds x="7" y="7" width="1" height="1" />
		</element>


<!-- bottom panel LZ0 -->
		<!-- Risiko  -->
		<element name="lamp07" ref="button_risk">
			<bounds x="25" y="500" width="65" height="25" />
		</element>

		<!-- Bonus ZE0/ZE5 -->
		<element name="lamp30" ref="button_bonus" inputtag="TZ3" inputmask="0x01">
			<bounds x="210" y="500" width="35" height="35" />
		</element>

		<element name="lamp00" ref="button_start" inputtag="TZ0" inputmask="0x80">
			<bounds x="375" y="500" width="65" height="25" />
		</element>
		<!-- reels -->


	</view>
</mamelayout>
