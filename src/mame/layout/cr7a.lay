<mamelayout version="2">
	<element name="red_led" defstate="0">
		<disk state="0"><color red="0.20" green="0.20" blue="0.20" /></disk>
		<disk state="1"><color red="1.00" green="0.00" blue="0.00" /></disk>
	</element>

	<element name="digit" defstate="0">
		<led7seg>
			<color red="1.0" green="0.3" blue="0.2" />
		</led7seg>
	</element>

	<element name="button_yellow" defstate="0">
		<rect><bounds x="0.0" y="0.0" width="1.0" height="1.0" /><color red="0" green="0" blue="0.0" /></rect>
		<rect state="1"><bounds x="0.1" y="0.1" width="0.9" height="0.9" /><color red="1.0" green="1.0" blue="0.0" /></rect>
		<rect state="0"><bounds x="0.1" y="0.1" width="0.9" height="0.9" /><color red="0.7" green="0.7" blue="0.0" /></rect>
	</element>

	<element name="button_red" defstate="0">
		<rect><bounds x="0.0" y="0.0" width="1.0" height="1.0" /><color red="0" green="0" blue="0.0" /></rect>
		<rect state="1"><bounds x="0.1" y="0.1" width="0.9" height="0.9" /><color red="1.0" green="0.0" blue="0.0" /></rect>
		<rect state="0"><bounds x="0.1" y="0.1" width="0.9" height="0.9" /><color red="0.7" green="0.0" blue="0.0" /></rect>
	</element>

	<element name="lamp" defstate="0">
		<rect state="1"><bounds x="0.1" y="0.1" width="0.9" height="0.9" /><color red="1.0" green="1.0" blue="0.9" /></rect>
		<rect state="0"><bounds x="0.1" y="0.1" width="0.9" height="0.9" /><color red="0.3" green="0.3" blue="0.3" /></rect>
	</element>

